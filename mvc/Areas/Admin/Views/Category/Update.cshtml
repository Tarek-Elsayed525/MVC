@model mvc.Models.Category

@{
    ViewData["Title"] = "Update Category";
}

<div class="container my-4" style="max-width: 900px;">
    <h2 class="fw-normal mb-4 text-secondary">Update Category</h2>

    <form asp-action="Update" method="post">
        <!-- مهم جداً: تمرير الـ ID مخفياً عشان الـ Controller يعرف العنصر المراد تعديله -->
        <input type="hidden" asp-for="Id" />

        <!-- حقل الاسم -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label text-secondary">Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger" value ="@Model.Name"></span>
        </div>

        <!-- حقل الوصف -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label text-secondary">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4">@Model.Description</textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- حقل الحالة -->
        <div class="mb-4">
            <label asp-for="Status" class="form-label text-secondary">Status</label>
            <select asp-for="Status" class="form-select">
                @if (Model.Status == true)
                {
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                }
                else
                {
                    <option value="true">Active</option>
                    <option value="false" selected>Inactive</option>
                }
                
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <!-- زر الحفظ -->
        <div>
            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
        </div>
    </form>
</div>

