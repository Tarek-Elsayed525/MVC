@model mvc.Models.Category

@{
    ViewData["Title"] = "Create new Category";
}

<div class="container my-4" style="max-width: 900px;">
    <!-- عنوان الصفحة -->
    <h2 class="fw-normal mb-4 text-secondary">Create new Category</h2>

    <form asp-action="Create" method="post">
        <!-- حقل الاسم -->
        <div class="mb-3">
            <label asp-for="Name" class="form-label text-secondary">Name</label>
            <input asp-for="Name" class="form-control" placeholder="" name="Name"/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <!-- حقل الوصف -->
        <div class="mb-3">
            <label asp-for="Description" class="form-label text-secondary">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="You Description Here..." name="Description"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <!-- حقل الحالة -->
        <div class="mb-4">
            <label asp-for="Status" class="form-label text-secondary">Status</label>
            <select asp-for="Status" class="form-select" name="Status">
                <option value="true">Active</option>
                <option value="false">Inactive</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <!-- زر الإرسال -->
        <div>
            <button type="submit" class="btn btn-primary px-4">Submit</button>
        </div>
    </form>
</div>

