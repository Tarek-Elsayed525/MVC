@model mvc.Models.Product

@{
    ViewData["Title"] = "Update Product";
}

<div class="container my-4" style="max-width: 900px;">
    <div class="card shadow-lg border-0 rounded-4 p-4 bg-white bg-opacity-95">
        <div class="card-body">
            <!-- عنوان الصفحة -->
            <h2 class="fw-bold text-dark mb-4">Update Product</h2>

            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <!-- مهم جداً: تمرير الـ ID مخفياً عشان الـ Controller يعرف العنصر المراد تعديله -->
                <input type="hidden" asp-for="Id" />
                <!-- الاحتفاظ بالصورة الرئيسية القديمة في حال لم يقم المستخدم برفع صورة جديدة -->
                <input type="hidden" asp-for="MainImg" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- حقل الاسم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- حقل السعر -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="price" class="form-label fw-semibold">Price</label>
                        <input asp-for="price" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="price" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- حقل الكمية -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input asp-for="Quantity" type="number" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <!-- حقل الخصم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Discount" class="form-label fw-semibold">Discount</label>
                        <input asp-for="Discount" type="number" class="form-control" />
                        <span asp-validation-for="Discount" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- حقل التقييم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Rate" class="form-label fw-semibold">Rate</label>
                        <input asp-for="Rate" type="number" class="form-control" />
                        <span asp-validation-for="Rate" class="text-danger"></span>
                    </div>

                    <!-- حقل الحالة -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- قائمة الأقسام (Categories) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <!-- قائمة الماركات (Brands) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label fw-semibold">Brand</label>
                        <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "Id", "Name"))">
                            <option value="">-- Select Brand --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                </div>

                <!-- حقل الوصف -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- حقل الصورة الرئيسية مع المعاينة الفورية -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Main Image</label>
                    <input type="file" name="ImageFile" id="mainFileInput" class="form-control" accept="image/*" />

                    <div class="mt-3 text-center">
                        <img id="mainImagePreview"
                             src="@Url.Content("~/Admin/img/" + Model.MainImg)"
                             alt="Current Image"
                             class="rounded shadow-sm border"
                             style="max-height: 200px; max-width: 100%; object-fit: contain;" />
                    </div>
                </div>

                <!-- عرض الصور الفرعية الحالية مع زر الحذف (×) -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary">Current Sub Images</label>
                    <div id="existingSubImagesContainer" class="d-flex flex-wrap gap-3 mt-2">
                        @if (ViewBag.SubImages != null && ((List<mvc.Models.ProductSubImg>)ViewBag.SubImages).Count > 0)
                        {
                            foreach (var subImg in ViewBag.SubImages)
                            {
                                <div class="border rounded p-1 shadow-sm position-relative existing-sub-box" style="width: 120px; height: 120px;">
                                    <img src="~/Admin/img/@subImg.Image" class="w-100 h-100 rounded" style="object-fit: cover;" />

                                    <!-- حقل مخفي لتعريف الكنترولر بأن هذه الصورة باقية ولم تُحذف -->
                                    <input type="hidden" name="ExistingSubImages" value="@subImg.Image" />

                                    <!-- زر الحذف (×) للصور القديمة -->
                                    <button type="button"
                                            class="btn btn-danger btn-sm position-absolute removeSubImage shadow"
                                            style="top: -8px; right: -8px; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; padding: 0; z-index: 10;">
                                        &times;
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">No sub images found.</p>
                        }
                    </div>
                </div>

                <!-- حقل رفع صور فرعية جديدة مع المعاينة وزر الحذف (×) -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Add New Sub Images (Multiple)</label>
                    <input type="file" name="SubImageFiles" id="subImageInput" class="form-control" accept="image/*" multiple />
                    <div class="form-text text-muted">يمكنك اختيار صور جديدة للإضافة.</div>

                    <!-- مكان ظهور معاينة الصور الفرعية الجديدة مع زر الـ (×) لكل صورة -->
                    <div id="newSubImagesPreview" class="d-flex flex-wrap gap-3 mt-3"></div>
                </div>

                <!-- حقل الألوان -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Product Colors</label>
                    <div id="colorContainer">
                        @if (ViewBag.Colors != null && ((List<mvc.Models.ProductColor>)ViewBag.Colors).Count > 0)
                        {
                            foreach (var colorObj in ViewBag.Colors)
                            {
                                <div class="mb-2 d-flex align-items-center gap-1">
                                    <input type="color" class="form-control form-control-color" name="Colors" value="@colorObj.Color">
                                    <button type="button" class="btn btn-danger btn-sm removeColor">x</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-2 d-flex align-items-center">
                                <input type="color" class="form-control form-control-color" name="Colors">
                            </div>
                        }
                    </div>
                    <button type="button" id="addButtonColor" class="btn btn-outline-primary btn-sm mt-1">+ Add New Color</button>
                </div>

                <!-- أزرار التحكم -->
                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
                    <button type="submit" class="btn btn-primary px-5 fw-semibold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // 1. معاينة الصورة الرئيسية فور تغييرها
    document.getElementById('mainFileInput').addEventListener('change', function (event) {
        const file = event.target.files[0];
        const preview = document.getElementById('mainImagePreview');
        if (file) {
            preview.src = URL.createObjectURL(file);
        }
    });

    // 2. حذف صندوق الصورة الفرعية القديمة عند الضغط على زر الـ x
    document.getElementById('existingSubImagesContainer').addEventListener('click', (e) => {
        if (e.target.classList.contains('removeSubImage')) {
            e.target.closest('.existing-sub-box').remove();
        }
    });

    // 3. إدارة ومعاينة الصور الفرعية الجديدة مع إمكانية حذف أي صورة منها قبل الحفظ
    let dataTransfer = new DataTransfer();
    const subImageInput = document.getElementById('subImageInput');
    const previewContainer = document.getElementById('newSubImagesPreview');

    subImageInput.addEventListener('change', function (event) {
        // إضافة الملفات الجديدة المختار إلى كائن DataTransfer
        for (let i = 0; i < event.target.files.length; i++) {
            dataTransfer.items.add(event.target.files[i]);
        }
        // تحديث ملفات الـ input الفعلية
        subImageInput.files = dataTransfer.files;
        renderNewPreviews();
    });

    // حذف صورة جديدة من المعاينة عند الضغط على زر الـ (×) الخاص بها
    previewContainer.addEventListener('click', function (e) {
        if (e.target.classList.contains('removeNewSub')) {
            const index = parseInt(e.target.getAttribute('data-index'));

            // إنشاء كائن DataTransfer جديد واستثناء الصورة المحذوفة
            const newDataTransfer = new DataTransfer();
            const files = subImageInput.files;

            for (let i = 0; i < files.length; i++) {
                if (i !== index) {
                    newDataTransfer.items.add(files[i]);
                }
            }

            dataTransfer = newDataTransfer;
            subImageInput.files = dataTransfer.files;
            renderNewPreviews();
        }
    });

    function renderNewPreviews() {
        previewContainer.innerHTML = '';
        const files = subImageInput.files;

        for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const reader = new FileReader();

            reader.onload = function (e) {
                const div = document.createElement('div');
                div.className = 'border rounded p-1 shadow-sm position-relative';
                div.style.width = '120px';
                div.style.height = '120px';

                div.innerHTML = `
                    <img src="${e.target.result}" class="w-100 h-100 rounded" style="object-fit: cover;" />
                    <button type="button"
                            class="btn btn-danger btn-sm position-absolute removeNewSub shadow"
                            data-index="${i}"
                            style="top: -8px; right: -8px; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: bold; padding: 0; z-index: 10;">
                        &times;
                    </button>
                `;
                previewContainer.appendChild(div);
            }
            reader.readAsDataURL(file);
        }
    }

    // 4. إضافة حقول الألوان ديناميكياً وحذفها
    const colorContainer = document.getElementById('colorContainer');
    const addBtn = document.getElementById('addButtonColor');

    addBtn.addEventListener('click', () => {
        var colorRow = document.createElement('div');
        colorRow.className = 'mb-2 d-flex align-items-center gap-1';
        colorRow.innerHTML = `
            <input type="color" class="form-control form-control-color" name="Colors">
            <button type="button" class="btn btn-danger btn-sm removeColor">x</button>
        `;
        colorContainer.appendChild(colorRow);
    });

    colorContainer.addEventListener('click', (e) => {
        if (e.target.classList.contains('removeColor')) {
            e.target.parentElement.remove();
        }
    });
</script>