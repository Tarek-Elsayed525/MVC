@model mvc.Models.Product

@{
    ViewData["Title"] = "Create New Product";
  
}

<div class="container my-4" style="max-width: 900px;">
    <div class="card shadow-lg border-0 rounded-4 p-4 bg-white bg-opacity-95">
        <div class="card-body">

            <!-- عنوان الصفحة -->
            <h2 class="fw-bold text-dark mb-4">Create New Product</h2>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- حقل الاسم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Enter product name..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- حقل السعر -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="price" class="form-label fw-semibold">Price</label>
                        <input asp-for="price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="price" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- حقل الكمية -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input asp-for="Quantity" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <!-- حقل الخصم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Discount" class="form-label fw-semibold">Discount</label>
                        <input asp-for="Discount" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="Discount" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- حقل التقييم -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Rate" class="form-label fw-semibold">Rate</label>
                        <input asp-for="Rate" type="number" class="form-control" placeholder="0" />
                        <span asp-validation-for="Rate" class="text-danger"></span>
                    </div>

                    <!-- حقل الحالة -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- قائمة الأقسام (Categories) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <!-- قائمة الماركات (Brands) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label fw-semibold">Brand</label>
                        <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(ViewBag.Brands, "Id", "Name"))">
                            <option value="">-- Select Brand --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                </div>

                <!-- حقل الوصف -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter product description..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <!-- حقل الألوان (Colors) -->
                <div class="mb-3">
                    <label for="Color" class="form-label fw-semibold">Product Colors</label>

                    <div id="colorContainer">
                        <div class="mb-2 d-flex align-items-center">
                            <input type="color" class="form-control form-control-color" name="Colors">
                        </div>
                    </div>

                    <button type="button" id="addButtonColor" class="btn btn-outline-primary btn-sm mt-1">+ Add New Color</button>
                </div>

                <!-- حقل رفع الصورة مع المعاينة الفورية -->
                <div class="mb-4">
                    <label asp-for="MainImg" class="form-label fw-semibold">Main Image</label>
                    <input type="file" name="ImageFile" id="fileInput" class="form-control" accept="image/*" />
                    <span asp-validation-for="MainImg" class="text-danger"></span>

                    <!-- مكان ظهور المعاينة -->
                    <div class="mt-3 text-center">
                        <img id="imagePreview" src="#" alt="Image Preview" class="rounded shadow-sm border" style="max-height: 200px; max-width: 100%; display: none;" />
                    </div>
                </div>

                <!-- حقل رفع الصور الفرعية المتعددة (Sub Images) -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">Sub Images</label>
                    <!-- تم تغيير الـ name إلى SubImageFiles واستبعاد asp-for -->
                    <input type="file" name="SubImageFiles" id="subFileInput" class="form-control" accept="image/*" multiple />
                    

                    <!-- مكان ظهور المعاينة -->
                    <div class="mt-3 text-center">
                        <img id="subImagePreview" src="#" alt="Sub Image Preview" class="rounded shadow-sm border" style="max-height: 200px; max-width: 100%; display: none;" />
                    </div>
                </div>

                <!-- أزرار التحكم -->
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
                    <button type="submit" class="btn btn-primary px-5 fw-semibold shadow-sm">Submit</button>
                </div>
            </form>

        </div>
    </div>
</div>


   
      
    

    <!-- سكريبت معاينة الصورة فور اختيارها -->
    <script>
        document.getElementById('fileInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');

            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
            } else {
                preview.src = '#';
                preview.style.display = 'none';
            }
        });
    </script>
<script>
    const colorContainer = document.getElementById('colorContainer');
    const addBtn = document.getElementById('addButtonColor');

    addBtn.addEventListener('click', () => {
        var colorRow = document.createElement('div');
        colorRow.className = 'mb-2 d-flex align-items-center gap-1';
        colorRow.innerHTML = `
            <input type="color" class="form-control form-control-color" name="Colors">
            <button type="button" class="btn btn-danger btn-sm removeColor">x</button>
        `;
        colorContainer.appendChild(colorRow);
    });

    colorContainer.addEventListener('click', (e) => {
        if (e.target.classList.contains('removeColor')) {
            e.target.parentElement.remove();
        }
    });
</script>
